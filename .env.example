# Copy this file to .env.local and write your own values.
# Get both values in the Supabase dashboard: Project Settings, then API.
# Both are safe in the browser. Set the same two names in Vercel.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The service role key is NOT safe in the browser. It never gets a VITE_ prefix.
# scripts/create-staff.mjs reads it from the shell, not from this file.
